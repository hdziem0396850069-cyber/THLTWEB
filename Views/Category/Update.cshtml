@model Webbanhang_TH02.Models.Category
@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container my-5" style="max-width: 600px;">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb breadcrumb-luxury">
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Cửa hàng</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý danh mục</a></li>
            <li class="breadcrumb-item active">Chỉnh sửa</li>
        </ol>
    </nav>

    <div class="card shadow-sm p-4 bg-white" style="border-radius: 15px; border: 1px solid #ebdcd5;">
        <h3 class="text-center mb-4" style="color: #8d5b4c; font-family: var(--font-heading); font-weight: bold;">CHỈNH SỬA DANH MỤC</h3>
        
        <form asp-controller="Category" asp-action="Update" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold" style="color: #2a201c;">Tên danh mục</label>
                <input asp-for="Name" class="form-control py-2" style="border-radius: 8px;" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-luxury-primary flex-grow-1 py-2">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn btn-luxury-outline flex-grow-1 py-2" style="background-color: #fff; border: 1px solid #ebdcd5; color: #8d5b4c;">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>
