@model Webbanhang_TH02.Models.Category
@{
    ViewData["Title"] = "Xóa danh mục";
    bool hasProducts = ViewBag.HasProducts ?? false;
}

<div class="container my-5" style="max-width: 600px;">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb breadcrumb-luxury">
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Cửa hàng</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý danh mục</a></li>
            <li class="breadcrumb-item active">Xóa danh mục</li>
        </ol>
    </nav>

    <div class="card shadow-sm p-4 bg-white text-center" style="border-radius: 15px; border: 1px solid #ebdcd5;">
        <div class="mb-3">
            <i class="bi bi-exclamation-triangle-fill display-3 text-warning"></i>
        </div>
        <h3 class="mb-3" style="color: #8d5b4c; font-family: var(--font-heading); font-weight: bold;">XÁC NHẬN XÓA DANH MỤC</h3>
        <p class="text-muted">Bạn có chắc chắn muốn xóa danh mục <strong>"@Model.Name"</strong> khỏi hệ thống?</p>

        @if (hasProducts)
        {
            <div class="alert alert-danger text-start small mb-4" role="alert">
                <i class="bi bi-shield-exclamation me-2"></i>
                <strong>Cảnh báo:</strong> Hiện tại đang có các sản phẩm thuộc danh mục này trong cửa hàng. Nếu xóa danh mục này, các sản phẩm thuộc danh mục này sẽ có nguy cơ lỗi hiển thị danh mục. Bạn nên chuyển đổi danh mục cho các sản phẩm trước khi thực hiện xóa.
            </div>
        }

        <form asp-controller="Category" asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-danger flex-grow-1 py-2" style="border-radius: 20px;">
                    <i class="bi bi-trash me-1"></i> Đồng ý xóa
                </button>
                <a asp-action="Index" class="btn btn-luxury-outline flex-grow-1 py-2" style="background-color: #fff; border: 1px solid #ebdcd5; color: #8d5b4c;">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>
