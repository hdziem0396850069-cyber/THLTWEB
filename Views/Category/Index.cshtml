@model IEnumerable<Webbanhang_TH02.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container my-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-luxury mb-2">
                    <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Cửa hàng</a></li>
                    <li class="breadcrumb-item active">Quản trị</li>
                </ol>
            </nav>
            <h2 class="checkout-page-title m-0"><i class="bi bi-tags-fill me-2"></i>Quản lý danh mục sản phẩm</h2>
        </div>
        <div>
            <a asp-action="Add" class="btn btn-luxury-primary-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm p-4 bg-white" style="border-radius: 15px;">
            <i class="bi bi-tags display-2 text-muted"></i>
            <h3 class="mt-3 text-dark" style="font-family: var(--font-heading);">Chưa có danh mục nào</h3>
            <p class="text-muted">Cửa hàng chưa có danh mục sản phẩm nào. Hãy tạo danh mục đầu tiên.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden; background: #fff;">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead style="background-color: #f6ebe6; color: #2a201c; font-family: var(--font-heading);">
                        <tr>
                            <th scope="col" class="py-3 ps-4" style="width: 100px;">MÃ SỐ</th>
                            <th scope="col" class="py-3">TÊN DANH MỤC</th>
                            <th scope="col" class="py-3 pe-4 text-center" style="width: 200px;">HÀNH ĐỘNG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr style="border-bottom: 1px solid #ebdcd5;">
                                <td class="py-3 ps-4 fw-bold text-luxury-primary" style="font-family: var(--font-heading);">
                                    #@cat.Id
                                </td>
                                <td class="py-3 font-weight-bold" style="color: #2a201c; font-size: 1.05rem;">
                                    @cat.Name
                                </td>
                                <td class="py-3 pe-4 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Update" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary" style="border-radius: 15px;" title="Sửa tên">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-danger" style="border-radius: 15px;" title="Xóa danh mục">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-4 d-flex gap-3">
            <a asp-controller="Product" asp-action="Management" class="btn btn-luxury-outline-sm">
                <i class="bi bi-box-seam me-1"></i> Quản lý sản phẩm
            </a>
            <a asp-controller="Order" asp-action="List" class="btn btn-luxury-outline-sm">
                <i class="bi bi-receipt me-1"></i> Quản lý đơn hàng
            </a>
        </div>
    }
</div>
