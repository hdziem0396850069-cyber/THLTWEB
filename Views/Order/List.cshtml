@model IEnumerable<Webbanhang_TH02.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid my-5 px-md-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-luxury mb-2">
                    <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Cửa hàng</a></li>
                    <li class="breadcrumb-item active">Quản trị</li>
                </ol>
            </nav>
            <h2 class="checkout-page-title m-0"><i class="bi bi-receipt-cutoff me-2"></i>Danh sách đơn hàng đã đặt</h2>
        </div>
        <div>
            <a asp-controller="Product" asp-action="Management" class="btn btn-luxury-outline-sm">
                <i class="bi bi-box-seam me-1"></i> Quản lý sản phẩm
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm p-4 bg-white" style="border-radius: 15px;">
            <i class="bi bi-inbox-fill display-2 text-muted"></i>
            <h3 class="mt-3 text-dark" style="font-family: var(--font-heading);">Chưa có đơn hàng nào</h3>
            <p class="text-muted">Hệ thống chưa ghi nhận bất cứ đơn đặt hàng nào từ khách hàng.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden; background: #fff;">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead style="background-color: #f6ebe6; color: #2a201c; font-family: var(--font-heading);">
                        <tr>
                            <th scope="col" class="py-3 ps-4">MÃ ĐƠN</th>
                            <th scope="col" class="py-3">NGÀY ĐẶT</th>
                            <th scope="col" class="py-3">KHÁCH HÀNG</th>
                            <th scope="col" class="py-3">SẢN PHẨM MUA</th>
                            <th scope="col" class="py-3 text-end">TỔNG TIỀN</th>
                            <th scope="col" class="py-3 text-center">THANH TOÁN</th>
                            <th scope="col" class="py-3 pe-4">ĐỊA CHỈ & GHI CHÚ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                        {
                            <tr style="border-bottom: 1px solid #ebdcd5;">
                                <td class="py-3 ps-4 fw-bold text-luxury-primary">
                                    @order.OrderCode
                                </td>
                                <td class="py-3 text-muted" style="font-size: 0.85rem;">
                                    @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold">@order.CustomerName</div>
                                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@order.Phone</div>
                                    @if (!string.IsNullOrEmpty(order.Email))
                                    {
                                        <div class="text-muted small" style="font-size: 0.75rem;"><i class="bi bi-envelope me-1"></i>@order.Email</div>
                                    }
                                </td>
                                <td class="py-3" style="max-width: 300px;">
                                    <ul class="list-unstyled mb-0 small">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li class="mb-1" style="color: #2a201c;">
                                                <i class="bi bi-chevron-right me-1" style="font-size: 0.7rem; color: #c48a73;"></i>
                                                <strong>@item.ProductName</strong> <span class="text-muted">x @item.Quantity</span> (@string.Format("{0:N0}", item.Price) đ)
                                            </li>
                                        }
                                    </ul>
                                </td>
                                <td class="py-3 text-end fw-bold text-luxury-primary" style="font-size: 1.05rem;">
                                    @string.Format("{0:N0}", order.TotalAmount) đ
                                </td>
                                <td class="py-3 text-center">
                                    @{
                                        string paymentText = order.PaymentMethod switch
                                        {
                                            "transfer" => "Chuyển khoản",
                                            "ewallet" => "Ví điện tử",
                                            _ => "COD"
                                        };
                                        string badgeClass = order.PaymentMethod switch
                                        {
                                            "transfer" => "bg-info text-dark",
                                            "ewallet" => "bg-warning text-dark",
                                            _ => "bg-secondary text-white"
                                        };
                                    }
                                    <span class="badge @badgeClass px-3 py-2" style="border-radius: 20px; font-weight: 500;">
                                        @paymentText
                                    </span>
                                </td>
                                <td class="py-3 pe-4 small" style="max-width: 250px;">
                                    <div><i class="bi bi-geo-alt-fill me-1 text-muted"></i>@order.Address</div>
                                    @if (!string.IsNullOrEmpty(order.Note))
                                    {
                                        <div class="text-muted italic mt-1" style="border-left: 2px solid #ebdcd5; padding-left: 5px;">
                                            <i class="bi bi-chat-left-text me-1"></i>@order.Note
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
