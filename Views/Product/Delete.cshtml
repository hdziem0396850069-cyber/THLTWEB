@model Webbanhang_TH02.Models.Product
@{
    ViewData["Title"] = "Xác nhận xóa " + Model.Name;
    var categoryName = ViewBag.CategoryName as string ?? "Mỹ phẩm";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card-luxury text-center">
                <div class="delete-icon-wrapper mb-3 text-danger">
                    <i class="bi bi-exclamation-triangle-fill display-3"></i>
                </div>
                
                <h2 class="form-title-luxury text-danger">Xác Nhận Xóa?</h2>
                <p class="form-subtitle-luxury text-muted">Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa sản phẩm này ra khỏi hệ thống?</p>
                
                <div class="product-delete-preview my-4 p-3 border rounded-glow d-flex align-items-center gap-3 text-start">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='/images/placeholder_cosmetics.jpg';" />
                    <div>
                        <span class="d-block text-muted small">@Model.Brand</span>
                        <strong class="d-block text-dark">@Model.Name</strong>
                        <span class="text-luxury-accent">@string.Format("{0:N0}", Model.Price) đ</span>
                    </div>
                </div>

                <form asp-action="DeleteConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex flex-column gap-2">
                        <button type="submit" class="btn btn-luxury-danger py-3"><i class="bi bi-trash-fill me-2"></i> Đồng ý Xóa Vĩnh Viễn</button>
                        <a asp-action="Index" class="btn btn-luxury-outline py-3">Hủy và quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
