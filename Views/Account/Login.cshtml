@model Webbanhang_TH02.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm p-4" style="border-radius: 15px;">
                <h3 class="text-center mb-4" style="color: #A37055; font-weight: bold;">ĐĂNG NHẬP</h3>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn w-100 py-2 text-white" style="background-color: #A37055; border-radius: 50px;">Đăng Nhập</button>
                </form>
                <p class="text-center mt-3 mb-0">Chưa có tài khoản? <a asp-action="Register" style="color: #A37055;">Đăng ký tại đây</a></p>
            </div>
        </div>
    </div>
</div>